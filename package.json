{
  "name": "ai-novel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:check": "tsx scripts/docs-check.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run docs:check && npm run eval:check",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:deploy": "dotenv -e .env -- prisma migrate deploy",
    "db:reset": "dotenv -e .env -- prisma migrate reset --force",
    "db:smoke": "dotenv -e .env -- tsx scripts/db-smoke-test.ts",
    "backup:check": "dotenv -e .env -- tsx scripts/backup-check.ts",
    "eval:serial": "tsx scripts/eval-serial-agent.ts",
    "eval:ai": "tsx scripts/eval-ai-quality.ts",
    "eval:novel-quality": "tsx scripts/eval-novel-quality.ts",
    "eval:novel-quality:runs": "EVAL_NOVEL_QUALITY_RUNS=3 tsx scripts/eval-novel-quality.ts",
    "eval:novel-quality:matrix": "tsx scripts/eval-novel-quality-matrix.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "eval:critic-revise": "tsx scripts/eval-critic-revise.ts",
    "eval:golden": "tsx scripts/eval-golden-correlation.ts",
    "eval:check": "tsx scripts/eval-novel-quality-matrix.ts --baseline docs/evals/baselines/novel-quality-matrix-fixture-fallback-2026-10-03.json --tolerance 5",
    "jobs:worker": "dotenv -e .env -- tsx scripts/jobs-worker.ts",
    "auto:generate": "dotenv -e .env -- tsx scripts/auto-generate.ts",
    "smoke:onboarding": "dotenv -e .env -- tsx scripts/onboarding-api-smoke.ts",
    "prompt:bible": "tsx scripts/test-bible-prompt.ts",
    "postinstall": "prisma generate",
    "auto:new": "node --import tsx/esm scripts/cli.ts",
    "memory:backfill": "dotenv -e .env -- tsx scripts/backfill-story-memory.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@iarna/toml": "^2.2.5",
    "@prisma/client": "^6.2.1",
    "@types/diff": "^7.0.2",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "docx": "^9.6.1",
    "epub-gen-memory": "^1.1.2",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.31",
    "partial-json": "^0.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-reconciler": "^0.29.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^2.1.9",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "type": "module"
}
